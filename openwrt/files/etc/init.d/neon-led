#!/bin/sh /etc/rc.common
# RGB status light driver for the Motorola MH7021 -- see /usr/sbin/neon-led.
# Runs after OpenWrt's own 'led' service (S96) and hands the light back as
# steady blue ("no status") when stopped or on reboot.
START=97
STOP=85
USE_PROCD=1
PROG=/usr/sbin/neon-led

start_service() {
	[ -e /sys/class/leds/red:status ] || return 0
	procd_open_instance
	procd_set_param command $PROG run
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}

service_stopped() {
	[ -e /sys/class/leds/red:status ] || return 0
	rm -f /var/run/neon-led.override /var/run/neon-led.state
	$PROG show blue
}

service_triggers() {
	procd_add_reload_trigger neon_led
}
